<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MisarMail</RootNamespace>
    <AssemblyName>MisarMail</AssemblyName>

    <!-- NuGet metadata -->
    <PackageId>MisarMail</PackageId>
    <Version>1.0.0</Version>
    <Authors>Misar AI</Authors>
    <Company>Misar AI Technology Pvt Ltd</Company>
    <Description>.NET client for MisarMail's transactional and marketing email API: send mail, run campaigns and A/B tests, manage contacts, segments, templates and automations, verify domains and DMARC, validate addresses, track revenue and read analytics. 33 resource groups over async/await, with retries, typed plan-limit errors and SSE streaming.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://misarmail.com/docs/sdks/csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Misar-AI/misarmail-sdks</RepositoryUrl>
    <PackageTags>misarmail;email;email-api;transactional-email;email-marketing;campaigns;newsletter;smtp;deliverability;dmarc;email-validation;contacts;templates;automation;analytics;webhooks;sse;api-client;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Tests/ is its own project (Tests/MisarMailTests.csproj) and references xUnit.
    Without this exclusion the SDK's default **/*.cs glob pulls the test sources
    into the library build, which then fails on the missing xUnit reference.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
