{
  "name": "@misarmail/sdk",
  "version": "5.0.1",
  "description": "MisarMail's transactional and marketing email API in TypeScript: send mail, run campaigns and A/B tests, manage contacts, segments, templates and automations, verify domains and DMARC, validate addresses, track revenue, read analytics \u2014 43 typed resources, retries, SSE streaming, ESM+CJS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "misarmail",
    "email",
    "email-api",
    "transactional-email",
    "email-marketing",
    "campaigns",
    "newsletter",
    "smtp",
    "deliverability",
    "dmarc",
    "email-validation",
    "contacts",
    "templates",
    "webhooks",
    "sdk",
    "api-client",
    "typescript",
    "javascript",
    "esm",
    "sse",
    "marketing-automation",
    "segments",
    "misar"
  ],
  "author": "Misar AI <hello@misar.io> (https://misar.io)",
  "license": "MIT",
  "homepage": "https://www.misarmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misarmail-sdks.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Misar-AI/misarmail-sdks/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
