{
  "name": "@misarmail/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript/JavaScript SDK for MisarMail \u2014 full API coverage, retry, ESM+CJS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "misarmail",
    "email",
    "sdk",
    "api",
    "transactional",
    "marketing"
  ],
  "author": "Misar AI <hello@misar.io>",
  "license": "MIT",
  "homepage": "https://misarmail.com/docs/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misar-AI/misarmail-sdks.git",
    "directory": "typescript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
