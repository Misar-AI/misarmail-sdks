{
    "name": "misarai/misarmail-php",
    "description": "PHP client for MisarMail's transactional and marketing email API: send mail, run campaigns and A/B tests, manage contacts, segments, templates and automations, verify domains and DMARC, validate addresses, track revenue and read analytics \u2014 33 resource groups, retries, typed plan-limit errors, SSE streaming.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://misarmail.com",
    "keywords": [
        "misarmail",
        "email",
        "email-api",
        "transactional-email",
        "email-marketing",
        "campaigns",
        "newsletter",
        "smtp",
        "deliverability",
        "dmarc",
        "email-validation",
        "contacts",
        "templates",
        "automation",
        "analytics",
        "webhooks",
        "sse",
        "api-client"
    ],
    "authors": [
        {
            "name": "Misar AI",
            "email": "hello@misar.io"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MisarMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MisarMail\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests/"
    }
}
