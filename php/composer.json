{
    "name": "misarai/misarmail-php",
    "description": "PHP client for MisarMail's transactional and marketing email API: send mail, run campaigns and A/B tests, manage contacts, segments, templates and automations, verify domains and DMARC, validate addresses, track revenue and read analytics — 33 resource groups, retries, typed plan-limit errors, SSE streaming.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://www.misarmail.com",
    "keywords": [
        "misarmail",
        "email",
        "email-api",
        "transactional-email",
        "email-marketing",
        "campaigns",
        "newsletter",
        "smtp",
        "deliverability",
        "dmarc",
        "email-validation",
        "contacts",
        "templates",
        "automation",
        "analytics",
        "webhooks",
        "sse",
        "api-client",
        "marketing-automation",
        "segments",
        "misarmail-php",
        "misar"
    ],
    "authors": [
        {
            "name": "Misar AI",
            "email": "hello@misar.io",
            "homepage": "https://misar.io",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Misar-AI/misarmail-sdks/issues",
        "source": "https://github.com/Misar-AI/misarmail-sdks/tree/main/php",
        "docs": "https://docs.misar.io/mail"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MisarMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MisarMail\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests/"
    }
}
